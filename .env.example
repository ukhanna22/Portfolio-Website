# Required for the "Ask my portfolio" chatbot (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Optional: override the chat model (defaults to claude-opus-5-5)
CHAT_MODEL=
# Optional: dense embeddings for retrieval at build time + query time (falls back to BM25 without it)
VOYAGE_API_KEY=
VOYAGE_MODEL=
# Optional: show [TODO] placeholders in a production build (they always show in `next dev`)
NEXT_PUBLIC_SHOW_TODOS=
